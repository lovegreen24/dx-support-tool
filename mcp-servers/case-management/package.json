{
  "name": "case-management-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Googleスプレッドシート(案件進捗シート)で6承認ポイントの進捗を記録・取得するMCPサーバー(record_case_approval / list_case_progress)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --coverage",
    "test:integration:external": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration/external --runInBand",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.6.3"
  }
}
