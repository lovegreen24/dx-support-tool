{
  "name": "digital-maturity-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "営業/総務経理/労務/社内基盤のDX成熟度をヒアリング回答からスコアリングするMCPサーバー(assess_digital_maturity)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --coverage",
    "test:integration:internal": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration/internal --runInBand",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.6.3"
  }
}
